# LiveKit Cloud (free Build plan works): https://cloud.livekit.io  ->  Settings -> Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# AI (optional until you add it). Any OpenAI-compatible provider works.
# Gemini:  AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Groq:    AI_BASE_URL=https://api.groq.com/openai/v1
# OpenAI:  AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Optional: lets hosts link Google Drive for recordings (Google Cloud > OAuth client ID, type Web, add your site as an authorised JavaScript origin)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Chatbot (optional): its own provider so it never uses up the meeting AI's quota. Any OpenAI-compatible API.
# Example: CHAT_BASE_URL=https://freemodel.in/v1   (leave CHAT_MODEL empty to auto-pick one the provider offers)
CHAT_API_KEY=
CHAT_BASE_URL=https://freemodel.in/v1
CHAT_MODEL=

# Support tokens are emailed to densee.ai@gmail.com. Best: a free Resend key (resend.com). Without it, FormSubmit is used
# (the very first request makes FormSubmit email the inbox an activation link: click it once).
RESEND_API_KEY=
SUPPORT_TO=densee.ai@gmail.com
SUPPORT_FROM=Dense Meet <onboarding@resend.dev>

# --- Support + Admin (/admin) ---
# Upstash Redis (free, pick Mumbai region) — needed for shared chat state, admin queue, handoff
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Admin login (defaults: mayank / kumar@146). Override in production.
ADMIN_USER=
ADMIN_PASSWORD=
ADMIN_SECRET=
# Site the bot reads for live Dense AI knowledge
DENSE_SITE_URL=https://dense-ai.vercel.app
